# ── Backend ───────────────────────────────────────────────
BACKEND_URL=http://localhost:3001
API_BASE=/api/v1

# ── Kredensial device (user kasir/admin cabang ybs) ───────
TENANT_SLUG=demo-fnb
BRIDGE_USERNAME=kasir
BRIDGE_PASSWORD=kasir123
# Override cabang yang dipantau (kosong = ikut cabang user token)
BRANCH_ID=

# ── HTTP health/status lokal ─────────────────────────────
PORT=4599

# ── Printer ──────────────────────────────────────────────
# console = cetak plaintext ke terminal (dev/tanpa printer)
# tcp     = kirim ESC/POS ke printer jaringan (raw port 9100)
# Bridge mencetak Struk Kasir + Nota Dapur saat order DITERIMA
# (auto-accept server ATAU kasir terima manual di POS).
#
# SUMBER ALAMAT PRINTER: kalau di Pengaturan POS ada printer slot
# cashier/kitchen/defaultPrinter dgn koneksi "Network (LAN)", bridge PAKAI ITU
# (di-refresh tiap 60 dtk). Env di bawah cuma FALLBACK kalau Pengaturan belum
# diisi / printernya USB/Bluetooth (bridge tak bisa USB/BT — itu wewenang POS).
PRINTER_MODE=console

# Fallback printer dapur (Nota Dapur / CHECKER)
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
PRINTER_COLS=48
PRINTER_CUT=true

# Fallback printer struk kasir — kosongkan kalau kasir & dapur satu printer
RECEIPT_PRINTER_HOST=
RECEIPT_PRINTER_PORT=9100
RECEIPT_COLS=48

RECONNECT_DELAY_MS=2000
