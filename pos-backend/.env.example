# ─────────────────────────────────────────────────────────
# Goldenity POS V2 Backend — Environment
# ─────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001
# `*` (dev), satu origin, atau daftar dipisah koma (staging: web-order + backoffice).
# Dipakai bersama oleh Express CORS dan Socket.IO. Hindari `*` saat kredensial aktif.
CORS_ORIGIN=*

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goldenity_pos_v2?schema=public"

# JWT
JWT_SECRET=REPLACE_ME_WITH_STRONG_RANDOM_SECRET_32_BYTES
JWT_EXPIRES_IN=24h

# Socket
SOCKET_ORIGIN=*

# ── Web Order (customer) — dipakai untuk membangun URL QR meja ──
# Format QR: {WEB_ORDER_BASE_URL}/{tenantSlug}/{branchId}/t/{qrToken}
# Staging/prod: set ke origin app pos-web-order yang ter-deploy.
WEB_ORDER_BASE_URL=https://order.goldenity.app

# ── Fase 3 (LEGACY): sinkronisasi langganan push dari Admin Core ──
# Dipakai hanya saat TENANT_DB_MODE=single. Di mode multi, langganan dibaca langsung
# dari DB Admin Core (ADMIN_CORE_DATABASE_URL) dan webhook PUT /subscription/:tenantId dihapus.
CORE_SYNC_TOKEN=

# ─────────────────────────────────────────────────────────
# MULTI-TENANT (DB fisik per-tenant) — arsitektur baru
# ─────────────────────────────────────────────────────────
# single  = perilaku lama (satu DATABASE_URL, mirror langganan lokal). DEFAULT.
# multi   = satu Postgres per tenant; identitas + langganan dibaca dari Admin Core.
TENANT_DB_MODE=single

# Koneksi READ-ONLY ke DB Admin Core (control plane): identitas tenant + tier + status + end_date.
# Pakai role Postgres yang hanya punya SELECT di: tenants, app_instances, solutions, branches, users.
ADMIN_CORE_DATABASE_URL=

# Registry milik pos-backend (Postgres kecil terpisah) — memetakan tenantId -> URL DB tenant.
# Tabel: tenant_db_registry (lihat prisma/manual/tenant_control_registry.sql).
POS_CONTROL_DATABASE_URL=

# Cache hasil resolve control-plane (ms). Default 45000. Negatif di-cache 10000.
CONTROL_PLANE_CACHE_TTL_MS=45000

# Manajer PrismaClient per-tenant.
TENANT_DB_MAX_CLIENTS=25
TENANT_DB_IDLE_TTL_MS=600000

# Masa tenggang langganan (hari) setelah end_date sebelum benar-benar SUSPENDED. Samakan dgn Admin Core (7).
SUBSCRIPTION_GRACE_DAYS=7

# Shared secret utk POST /api/v1/internal/cache/bust (Admin Core memanggil ini saat suspend/renew).
INTERNAL_SERVICE_TOKEN=

# Escape hatch khusus staging/support.
ALLOW_SUPERADMIN_TENANT_OVERRIDE=false
ALLOW_SUPERADMIN_SUSPENDED_LOGIN=true
