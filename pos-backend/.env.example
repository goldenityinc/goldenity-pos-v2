# ─────────────────────────────────────────────────────────
# Goldenity POS V2 Backend — Environment
# ─────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001
# `*` (dev), satu origin, atau daftar dipisah koma (staging: web-order + backoffice).
# Dipakai bersama oleh Express CORS dan Socket.IO. Hindari `*` saat kredensial aktif.
CORS_ORIGIN=*

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goldenity_pos_v2?schema=public"

# JWT
JWT_SECRET=REPLACE_ME_WITH_STRONG_RANDOM_SECRET_32_BYTES
JWT_EXPIRES_IN=24h

# Socket
SOCKET_ORIGIN=*

# ── Fase 3: sinkronisasi langganan dari Admin Core ──
# Shared secret; Admin Core kirim di header x-core-sync-token saat PUT /api/v1/subscription/:tenantId.
# Kosong = jalur core-sync dimatikan (hanya SUPER_ADMIN JWT yang bisa tulis langganan).
CORE_SYNC_TOKEN=
