// ─────────────────────────────────────────────────────────
// Goldenity POS V2 — Prisma Schema (Fase 1)
// Sumber: ERD_POS_V2_FASE1.md §2 Prisma Schema Lengkap
// ─────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// EPIC 1 — Auth & Multi-Tenant Core
// ─────────────────────────────────────────────────────────

model Tenant {
  id                      String       @id @default(uuid())
  slug                    String       @unique
  name                    String
  logoUrl                 String?
  address                 String?
  phone                   String?
  receiptFooter           String?
  taxSettings             Json?
  qrisImageUrl            String?
  allowPayAtCashier       Boolean      @default(true)
  isPaymentProofMandatory Boolean      @default(false)
  blindShiftClose         Boolean      @default(false)
  taxEnabled              Boolean      @default(true)
  taxRatePercentage       Int          @default(11)
  pricesIncludeTax        Boolean      @default(false)
  // Terima + cetak web order (struk kasir + nota dapur) otomatis begitu masuk.
  // Off = kasir terima manual di POS, cetak menyusul saat diterima.
  webOrderAutoAccept      Boolean      @default(false)
  isActive                Boolean      @default(true)
  // LEGACY string — dipertahankan utk kompat. Sumber kebenaran baru = Subscription.status.
  subscriptionStatus      String?
  allowedSolutions        String[]
  // Mode bisnis aktif (F&B / Retail / Bengkel). Di-mirror dari Admin Core; sisi tenant read-only.
  businessCategory        BusinessCategory @default(RETAIL_FNB)
  subscription            Subscription?
  subscriptionEvents      SubscriptionEvent[]
  branches                Branch[]
  users                   User[]
  customRoles             CustomRole[]
  categories              Category[]
  products                Product[]
  productVariantStocks    ProductVariantStock[]
  salesRecords            SalesRecord[]
  storeSettings           StoreSetting[]
  cashierShifts           CashierShift[]
  webOrders               WebOrder[]
  notificationEvents      NotificationEvent[]
  devices                 Device[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}

enum WebOrderPaymentMode {
  QRIS_ONLY         // customer web order HANYA boleh QRIS statis
  QRIS_AND_CASHIER  // QRIS statis + "Bayar di Kasir"
}

model Branch {
  id             String          @id @default(uuid())
  tenantId       String
  name           String
  qrisImageUrl   String?
  // Pengaturan per-cabang (disimpan di DB per cabang, bukan tenant-level).
  webOrderPaymentMode WebOrderPaymentMode @default(QRIS_AND_CASHIER)
  isActive       Boolean         @default(true)
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  users          User[]
  products       Product[]
  salesRecords   SalesRecord[]
  printerConfigs PrinterConfig[]
  cashierShifts  CashierShift[]
  diningTables       DiningTable[]
  webOrders          WebOrder[]
  queueCounters      QueueCounter[]
  notificationEvents NotificationEvent[]
  devices            Device[]
  createdAt      DateTime        @default(now())

  @@index([tenantId])
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  CASHIER
  CRM_STAFF
  WORKSHOP_ADMIN
  ACCOUNTANT
}

model User {
  id           String      @id @default(uuid())
  tenantId     String
  branchId     String?
  // Nama tampilan karyawan (Data Karyawan di Back Office). Null → UI fallback ke username.
  name         String?
  email        String?
  username     String
  passwordHash String
  role         UserRole
  customRoleId String?
  isActive     Boolean     @default(true)
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  branch       Branch?     @relation(fields: [branchId], references: [id])
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])
  salesRecords SalesRecord[] @relation("CashierSales")
  cashierShifts CashierShift[]
  createdAt    DateTime    @default(now())

  @@unique([tenantId, username])
  @@index([branchId])
  @@index([email])
}

model CustomRole {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  // Role bawaan (Admin/Kasir/Pajak) — tidak bisa dihapus, boleh di-tweak permission-nya.
  isDefault   Boolean  @default(false)
  // Matriks RBAC: { "<moduleKey>": { "c": bool, "r": bool, "u": bool, "d": bool }, ... }
  permissions Json
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────
// FASE 3 — Back Office: Mode Bisnis & Langganan
// Sumber kebenaran langganan = Admin Core (AppInstance). Tabel ini
// adalah read-model lokal supaya POS/Back Office jalan mandiri.
// Detail: ERD_POS_V2_FASE3_BACKOFFICE.md
// ─────────────────────────────────────────────────────────

enum BusinessCategory {
  GENERAL
  RETAIL_FNB
  SERVICES_AUTOMOTIVE
}

enum SubscriptionTier {
  STANDARD
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  GRACE
  SUSPENDED
  EXPIRED
}

enum SubscriptionEventType {
  PROVISIONED
  RENEWED
  TIER_CHANGED
  SUSPENDED
  REACTIVATED
  REMINDER_SHOWN
}

model Subscription {
  id                  String             @id @default(uuid())
  tenantId            String             @unique
  tier                SubscriptionTier   @default(STANDARD)
  status              SubscriptionStatus @default(ACTIVE)
  startDate           DateTime           @default(now())
  endDate             DateTime
  graceDays           Int                @default(7)
  billingContactName  String?            @default("Tim Goldenity")
  billingContactPhone String?
  billingContactEmail String?
  externalRef         String? // AppInstance.id di Admin Core
  lastReminderAt      DateTime?
  notes               String?
  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model SubscriptionEvent {
  id        String                @id @default(uuid())
  tenantId  String
  type      SubscriptionEventType
  meta      Json?
  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  createdAt DateTime              @default(now())

  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────────────────
// EPIC 2 — Inventaris & Kategori
// ─────────────────────────────────────────────────────────

model Category {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id                String   @id @default(uuid())
  tenantId          String
  branchId          String?
  clientReferenceId String?  @unique
  name              String
  categoryLegacy    String?  @map("category")  // LEGACY V1: DB column bernama "category" (string, 9 non-null values). Prisma field name = categoryLegacy agar TIDAK bentrok dengan relation object dibawah. Akan dimigrasikan normalize ke categoryId UUID mapping nanti.
  categoryId        String?
  price             Decimal
  cost              Decimal?
  barcode           String?
  sku               String?
  stock             Int?
  isActive          Boolean  @default(true)
  imageUrl          String?
  variants          Json?
  description       String?
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  branch            Branch?  @relation(fields: [branchId], references: [id])
  category          Category? @relation(fields: [categoryId], references: [id])  // RELATION NAME TETAP "category" = 7 line BE code (product.service.ts/dashboard.service.ts) TIDAK perlu diubah 0 regression!
  items             SalesRecordItem[]
  productVariantStocks ProductVariantStock[]
  webOrderItems     WebOrderItem[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId, categoryId])
  @@index([barcode])
}

model ProductVariantStock {
  id               String   @id @default(uuid())
  tenantId         String
  productId        String
  variantOptionKey String
  sku              String?
  stock            Int      @default(0)
  minStock         Int?     @default(0)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([productId, variantOptionKey])
  @@index([tenantId, productId])
}

// ─────────────────────────────────────────────────────────
// EPIC 3 — Alur Penjualan
// ─────────────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  QRIS
  CREDIT_CARD
}

enum SaleStatus {
  COMPLETED
  VOIDED
  PARTIALLY_REFUNDED
  REFUNDED
}

model SalesRecord {
  id                     BigInt         @id @default(autoincrement())
  referenceId            String         @unique
  tenantId               String
  branchId               String
  cashierId              String
  orderType              String
  subtotal               Decimal
  discountAmount         Decimal        @default(0)
  taxAmount              Decimal        @default(0)
  serviceChargeAmount    Decimal        @default(0)
  serviceChargePercentage Int?
  total                  Decimal
  paymentMethod          PaymentMethod  @default(CASH)
  paymentReferenceNumber String?
  cashReceived           Decimal?
  cashChange             Decimal?
  status                 SaleStatus     @default(COMPLETED)
  voidedAt               DateTime?
  voidedBy               String?
  voidReason             String?
  refundedAmount         Decimal?       @default(0)
  cashierNote            String?        // catatan kasir (ditambah/diedit dari detail Riwayat Penjualan)
  cashierShiftId         String?
  tenant                 Tenant         @relation(fields: [tenantId], references: [id])
  branch                 Branch         @relation(fields: [branchId], references: [id])
  cashier                User           @relation("CashierSales", fields: [cashierId], references: [id])
  cashierShift           CashierShift?  @relation(fields: [cashierShiftId], references: [id])
  items                  SalesRecordItem[]
  webOrder               WebOrder?
  createdAt              DateTime       @default(now())

  @@index([tenantId, branchId, createdAt])
  @@index([status])
  @@index([cashierShiftId])
}

model SalesRecordItem {
  id            BigInt      @id @default(autoincrement())
  salesRecordId BigInt
  productId     String?
  productName   String
  qty           Int
  unitPrice     Decimal
  lineTotal     Decimal
  note          String?
  salesRecord   SalesRecord @relation(fields: [salesRecordId], references: [id])
  product       Product?    @relation(fields: [productId], references: [id])

  @@index([salesRecordId])
}

// ─────────────────────────────────────────────────────────
// EPIC 3.5 — Closing Kasir Shift (Rekonsiliasi Kas Fisik)
// ─────────────────────────────────────────────────────────

enum ShiftStatus {
  OPEN
  CLOSED
}

model CashierShift {
  id             String       @id @default(uuid())
  tenantId       String
  branchId       String
  cashierId      String
  openedAt       DateTime     @default(now())
  closedAt       DateTime?
  status         ShiftStatus  @default(OPEN)
  openingCash    Decimal      @default(0)
  expectedCash   Decimal?
  actualCash     Decimal?
  discrepancy    Decimal?
  notes          String?
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  branch         Branch       @relation(fields: [branchId], references: [id])
  cashier        User         @relation(fields: [cashierId], references: [id])
  salesRecords   SalesRecord[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tenantId, branchId, status])
  @@index([cashierId, status])
}

// ─────────────────────────────────────────────────────────
// EPIC 4 — Printer & Pengaturan Perangkat Keras
// ─────────────────────────────────────────────────────────

model StoreSetting {
  id       String @id @default(uuid())
  tenantId String
  key      String
  value    String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
}

enum PrinterSlot {
  defaultPrinter
  kitchen
  cashier
}

enum PrinterConnectionType {
  bluetooth
  usb
  network
  none
}

model PrinterConfig {
  id             String                @id @default(uuid())
  branchId       String
  deviceId       String? // null = default cabang; non-null = override khusus 1 device (multi-device/cabang)
  slot           PrinterSlot
  connectionType PrinterConnectionType @default(none)
  address        String?
  port           Int?
  paperWidth     Int                   @default(58) // 58 | 80 (mm) — lebar kertas thermal per slot
  branch         Branch                @relation(fields: [branchId], references: [id])
  device         Device?               @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([branchId, deviceId, slot])
  @@index([deviceId])
}

// ─────────────────────────────────────────────────────────
// Multi-Device per cabang (port dari V1: X-Device-ID + /devices/register).
// Satu cabang bisa punya banyak device kasir + device dapur (CHECKER).
// ─────────────────────────────────────────────────────────
enum DeviceRole {
  CASHIER
  CHECKER
  BOTH
}

model Device {
  id             String          @id // UUID persisten dari klien (SharedPreferences `persistent_device_uuid`)
  tenantId       String
  branchId       String
  name           String
  role           DeviceRole      @default(BOTH)
  isActive       Boolean         @default(true)
  lastSeenAt     DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  branch         Branch          @relation(fields: [branchId], references: [id])
  printerConfigs PrinterConfig[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([branchId, role, isActive])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────
// EPIC 5 — Fase 2: Manajemen Meja / QR, Web Order, Queue & Notifikasi
// Sumber: ERD_POS_V2_FASE2_WEBORDER.md. Scope awal: DINE_IN_QR saja,
// QRIS statis manual (reuse Tenant/Branch.qrisImageUrl), tanpa delivery/KDS.
// ─────────────────────────────────────────────────────────

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  INACTIVE
}

enum TableReservationStatus {
  PENDING
  SEATED
  CANCELLED
}

model DiningTable {
  id           String             @id @default(uuid())
  branchId     String
  code         String // "A1", "B3" — WAJIB unik per branch
  qrToken      String             @unique // di-rotate tiap kali status kembali ke AVAILABLE
  capacity     Int?
  status       TableStatus        @default(AVAILABLE)
  branch       Branch             @relation(fields: [branchId], references: [id])
  sessions     TableSession[]
  reservations TableReservation[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([branchId, code])
  @@index([branchId, status])
}

model TableReservation {
  id          String                 @id @default(uuid())
  tableId     String
  name        String
  phone       String
  reservedAt  DateTime // tanggal + jam reservasi
  guests      Int                    @default(1)
  note        String?
  status      TableReservationStatus @default(PENDING)
  table       DiningTable            @relation(fields: [tableId], references: [id])
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([tableId, status])
}

enum TableSessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

model TableSession {
  id            String             @id @default(uuid())
  tableId       String
  sessionToken  String             @unique // disimpan di localStorage browser customer (BUKAN qrToken meja)
  status        TableSessionStatus @default(ACTIVE)
  customerName  String?
  customerPhone String?
  table         DiningTable        @relation(fields: [tableId], references: [id])
  webOrders     WebOrder[]
  openedAt      DateTime           @default(now())
  closedAt      DateTime?
  expiresAt     DateTime // openedAt + N jam; sesi idle > N jam dianggap EXPIRED

  @@index([tableId, status])
}

model WebOrder {
  id              String   @id @default(uuid())
  tenantId        String
  branchId        String
  tableSessionId  String?
  salesRecordId   BigInt?  @unique // terisi setelah ACCEPTED & masuk pipeline SalesRecord
  orderType       String   @default("DINE_IN_QR") // string bebas, validasi awal cuma DINE_IN_QR
  queueNumber     Int
  status          String   @default("SUBMITTED") // SUBMITTED|ACCEPTED|PREPARING|READY|SERVED|COMPLETED|CANCELLED (CART tidak dipersist di iterasi awal)
  subtotal        Decimal
  discountAmount  Decimal  @default(0)
  taxAmount       Decimal  @default(0)
  total           Decimal
  paymentMethod   String   @default("PAY_AT_CASHIER") // QRIS_STATIC | PAY_AT_CASHIER
  paymentStatus   String   @default("UNPAID") // UNPAID | PENDING_VERIFICATION | PAID
  paymentProofUrl String?  // bukti transfer QRIS yang di-upload customer (untuk dicek kasir)
  customerNote    String?
  rejectionReason String?
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  branch          Branch             @relation(fields: [branchId], references: [id])
  tableSession    TableSession?      @relation(fields: [tableSessionId], references: [id])
  salesRecord     SalesRecord?       @relation(fields: [salesRecordId], references: [id])
  items           WebOrderItem[]
  notifications   NotificationEvent[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([branchId, status, createdAt])
  @@index([tableSessionId])
}

model WebOrderItem {
  id                String   @id @default(uuid())
  webOrderId        String
  productId         String?
  productName       String // SNAPSHOT — konsisten dgn SalesRecordItem.productName
  qty               Int
  unitPrice         Decimal
  lineTotal         Decimal
  variantSelections Json?
  note              String?
  webOrder          WebOrder @relation(fields: [webOrderId], references: [id])
  product           Product? @relation(fields: [productId], references: [id])

  @@index([webOrderId])
}

model QueueCounter {
  id         String   @id @default(uuid())
  branchId   String
  dateKey    DateTime @db.Date // tanggal lokal branch
  lastNumber Int      @default(0) // increment atomik via $transaction
  branch     Branch   @relation(fields: [branchId], references: [id])

  @@unique([branchId, dateKey])
}

model NotificationEvent {
  id         String    @id @default(uuid())
  tenantId   String
  branchId   String
  webOrderId String?
  type       String // ORDER_SUBMITTED | ORDER_STATUS_CHANGED | QUEUE_CALLED | ORDER_READY
  channel    String    @default("POLL") // SOCKET | PUSH | POLL
  payload    Json
  delivered  Boolean   @default(false)
  retryCount Int       @default(0)
  printedAt  DateTime? // timestamp auto-print Checker+Struk berhasil
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  branch     Branch    @relation(fields: [branchId], references: [id])
  webOrder   WebOrder? @relation(fields: [webOrderId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([branchId, delivered, createdAt])
}
