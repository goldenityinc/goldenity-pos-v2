# ─────────────────────────────────────────────────────────
# Goldenity POS V2 — root .gitignore (monorepo)
# ─────────────────────────────────────────────────────────

# --- Secrets — JANGAN PERNAH commit ---
.env
.env.local
.env.*.local
**/.env
!**/.env.example

# --- Node / Backend ---
node_modules/
**/node_modules/
dist/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- Flutter (pos-native-desktop-tablet, pos-native-mobile) ---
**/build/
release_outputs/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/*.g.dart.bak

# --- Web (pos-web-order, pos-web-backoffice) ---
**/.next/
**/out/
**/.vite/

# --- IDE / OS ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# --- Scratch/local test output (jangan ikut ke-push) ---
backend_s24_err.txt
backend_s24_log.txt

# Uploaded images (logo, QRIS, product photos) — runtime, not in VCS
pos-backend/uploads/
